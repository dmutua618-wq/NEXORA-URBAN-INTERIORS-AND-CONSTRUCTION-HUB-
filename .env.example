# Gmail SMTP settings for Nexora admin authentication diagnostics
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail-username@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Nexora Admin" <your-gmail-username@gmail.com>

NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
PORT=4173
ALLOW_RESET_FALLBACK=false
